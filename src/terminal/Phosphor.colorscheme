; Phosphor colour scheme for QTerminal / qtermwidget.
;
; Mostly phosphor green, but red and amber are kept recognisable so error
; output, git diffs and ls colours stay readable. A fully monochrome palette
; looks great and is miserable to work in.

[General]
Description=Phosphor
Opacity=1

[Background]
Bold=false
Color=0,0,0
Transparency=false

[BackgroundIntense]
Bold=false
Color=4,10,5
Transparency=false

[Foreground]
Bold=false
Color=22,222,57
Transparency=false

[ForegroundIntense]
Bold=true
Color=25,255,66
Transparency=false

