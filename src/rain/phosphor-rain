#!/usr/bin/env bash
# Control script for the flat 2D Phosphor rain wallpaper.
set -uo pipefail

RENDERER="${HOME}/.local/share/phosphor-rain/rain.py"
CONF="${HOME}/.config/phosphor-rain.conf"
EXCLUDE=""
RAIN_OPTS="--fps 14 --size 16 --density 0.55"
# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

# Marker string used to find our own processes without matching this script.
MARK="phosphor-rain-renderer"

wait_for_layout() {
    # At login this may run before the monitor layout has settled (this box has
    # a fix-monitor-layout autostart). Poll xrandr until it reports the same
    # layout twice in a row, then proceed. Gives up after ~30s and starts anyway.
    local prev="" cur n=0
    while [ "$n" -lt 30 ]; do
        cur=$(xrandr --listmonitors 2>/dev/null | tail -n +2 | awk '{print $2,$3}')
        if [ -n "$cur" ] && [ "$cur" = "$prev" ]; then return 0; fi
        prev="$cur"; sleep 1; n=$((n+1))
    done
    return 0
}

excluded() { local m; for m in $EXCLUDE; do [ "$m" = "$1" ] && return 0; done; return 1; }

running_pids() {
    # Only consider python3 processes, so this can never match our own shell
    # (whose command line contains the renderer path as literal text).
    local p
    for p in $(pgrep -x python3 2>/dev/null); do
        if tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | grep -q "share/phosphor-rain/rain.py"; then
            echo "$p"
        fi
    done
}

stop() {
    local pids; pids=$(running_pids)
    if [ -n "$pids" ]; then kill $pids 2>/dev/null; sleep 0.5; fi
    echo "phosphor rain: stopped"
}

geometries() {
    xrandr --listmonitors | tail -n +2 | while read -r _i name geom _conn; do
        name="${name#+}"; name="${name#\*}"; name="${name#+}"
        local w h x y
        w=${geom%%/*}
        h=$(echo "$geom" | sed -E 's|^[0-9]+/[0-9]+x([0-9]+)/.*|\1|')
        x=$(echo "$geom" | sed -E 's|.*\+([0-9]+)\+[0-9]+$|\1|')
        y=$(echo "$geom" | sed -E 's|.*\+[0-9]+\+([0-9]+)$|\1|')
        if excluded "$name"; then echo "SKIP $name ${w}x${h}+${x}+${y}"
        else echo "USE $name ${w}x${h}+${x}+${y}"; fi
    done
}

start() {
    [ -n "$(running_pids)" ] && { echo "already running"; return 0; }
    local args=() line kind name geom
    while read -r kind name geom; do
        if [ "$kind" = "SKIP" ]; then echo "  skip  $name $geom  [excluded]"
        else echo "  rain  $name $geom"; args+=(--geometry "$geom"); fi
    done < <(geometries)
    [ ${#args[@]} -eq 0 ] && { echo "no eligible monitors" >&2; return 1; }
    # shellcheck disable=SC2086
    setsid nohup /usr/bin/python3 "$RENDERER" $RAIN_OPTS "${args[@]}" \
        >/tmp/phosphor-rain.log 2>&1 < /dev/null &
    sleep 2
    if [ -n "$(running_pids)" ]; then echo "phosphor rain: started"
    else echo "phosphor rain: FAILED - see /tmp/phosphor-rain.log" >&2
         tail -5 /tmp/phosphor-rain.log >&2; return 1; fi
}

case "${1:-start}" in
    start) [ "${2:-}" = "--wait" ] && wait_for_layout; start ;;
    stop) stop ;;
    restart) stop; start ;;
    toggle) if [ -n "$(running_pids)" ]; then stop; else start; fi ;;
    status) if [ -n "$(running_pids)" ]; then echo "running (pid $(running_pids | tr '\n' ' '))"
            else echo "not running"; fi ;;
    *) echo "usage: phosphor-rain {start [--wait]|stop|restart|toggle|status}" >&2
       exit 2 ;;
esac
