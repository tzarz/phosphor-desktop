#============================================================
#  "Phosphor" for Openbox - phosphor green on black
#  Generated from the "Nightmare" theme structure.
#============================================================

#======================================
#     Menu Settings
#======================================

menu.title.bg: flat
menu.title.bg.color: #000000
menu.title.text.color: #19FF42
menu.separator.color: #0A661A
menu.items.bg: flat
menu.items.bg.color: #000000
menu.items.text.color: #16DE39
menu.items.disabled.text.color: #075009
menu.items.active.bg: flat border
menu.items.active.bg.color: #063C0F
menu.items.active.bg.border.color: #19FF42
menu.items.active.text.color: #19FF42

#======================================
#     Focused Window Settings
#======================================

window.active.title.bg: flat
window.active.title.bg.color: #050A05
window.active.handle.bg: flat
window.active.handle.bg.color: #0A661A
window.active.grip.bg: parentrelative
window.active.label.bg: parentrelative
window.active.label.text.color: #19FF42
window.active.border.color: #19FF42
window.*.button.*.bg: parentrelative
window.active.button.*.image.color: #16DE39
window.active.button.hover.image.color: #19FF42
window.active.button.*.pressed.image.color: #000000
window.active.button.disabled.image.color: #075009

#======================================
#     Unfocused Window Settings
#======================================

window.inactive.title.bg: flat
window.inactive.title.bg.color: #000000
window.inactive.handle.bg: flat
window.inactive.handle.bg.color: #050A05
window.inactive.grip.bg: parentrelative
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #0A661A
window.inactive.border.color: #0A661A
window.inactive.button.*.image.color: #0A661A
window.inactive.button.hover.image.color: #16DE39

#======================================
#     Global Width Settings
#======================================

padding.width: 2
padding.height: 2
border.width: 1
window.handle.width: 2
window.client.padding.width: 0
menu.overlap.x: -5

#======================================
#     Miscellaneous Settings
#======================================

border.color: #0A661A
menu.border.color: #19FF42

#======================================
#     Osd
#======================================

osd.bg: flat
osd.bg.color: #000000
osd.label.bg: parentrelative
osd.label.text.color: #16DE39
osd.hilight.bg: flat border
osd.hilight.bg.color: #063C0F
osd.hilight.bg.border.color: #19FF42
osd.unhilight.bg: flat
osd.unhilight.bg.color: #050A05
osd.border.color: #0A661A

#======================================
#     Title Justification
#======================================

menu.title.text.justify: center
window.label.text.justify: center
